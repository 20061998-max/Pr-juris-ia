rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc used to verify database readiness
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Users and Licenses collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Trial requests sent from public onboarding
    match /trial_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Consultations and audits created in the terminal
    match /consultations/{consultationId} {
      allow read, write: if true;
    }
  }
}
